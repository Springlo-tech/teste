<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Cartão AR - Personalizado</title>

  <!-- A-Frame -->
  <script src="https://aframe.io/releases/1.2.0/aframe.min.js"></script>

  <!-- MindAR -->
  <script src="https://cdn.jsdelivr.net/npm/mind-ar@1.2.0/dist/mindar-image-aframe.prod.js"></script>

  <!-- Animation Mixer -->
  <script src="https://cdn.jsdelivr.net/gh/c-frame/aframe-extras@v6.1.1/dist/aframe-extras.min.js"></script>

  <style>
    body {
      margin: 0;
      overflow: hidden;
      font-family: Arial, sans-serif;
    }

    #splash-screen {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: #333;
      color: white;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      z-index: 9999;
      text-align: center;
    }

    #start-button {
      padding: 15px 30px;
      background-color: #007bff;
      color: white;
      font-size: 1.1em;
      border: none;
      border-radius: 8px;
      cursor: pointer;
      margin-top: 15px;
    }

    #start-button:active {
      transform: scale(0.97);
    }

    #logo-cliente {
      width: 120px;
      max-height: 120px;
      object-fit: contain;
      margin-bottom: 20px;
    }

    #minha-cena {
      display: none;
    }
  </style>
</head>

<body>

  <!-- ========================================================= -->
  <!-- TELA INICIAL -->
  <!-- ========================================================= -->
  <div id="splash-screen">
    <img id="logo-cliente" src="" alt="Logo Personalizado">
    <h2 id="titulo-cliente"></h2>
    <p>Toque para iniciar a câmera e ativar o som</p>
    <button id="start-button">Iniciar</button>
  </div>

  <!-- ========================================================= -->
  <!-- CENA AR -->
  <!-- ========================================================= -->
  <a-scene id="minha-cena" mindar-image="
    imageTargetSrc: markers/targets_BAPC.mind;
    maxTrack: 1;
    filterMinCF: 0.0001;
    filterBeta: 1000;"
    gltf-model="dracoDecoderPath: https://www.gstatic.com/draco/v1/decoders/;" color-space="sRGB"
    renderer="colorManagement: true; physicallyCorrectLights: false; exposure: 1.3;" vr-mode-ui="enabled: false"
    device-orientation-permission-ui="enabled: false">

    <a-light type="ambient" color="#FFFFFF" intensity="1.8"></a-light>

    <!-- ======================================================= -->
    <!-- ASSETS -->
    <!-- ======================================================= -->
    <a-assets timeout="10000">
      <!-- Imagens -->
      <img id="background-img0" src="assets/imagens/target0.jpg" crossorigin="anonymous">
      <img id="background-img1" src="assets/imagens/target1.jpg" crossorigin="anonymous">
      <img id="background-img2" src="assets/imagens/target2.jpg" crossorigin="anonymous">

      <!-- Modelos 3D na pasta assets/modelos -->
      <a-asset-item id="modeloPolvo" src="assets/modelos/polvo.glb"></a-asset-item>
      <a-asset-item id="modeloTubarao" src="assets/modelos/tubarao.glb"></a-asset-item>
      <a-asset-item id="modeloTubarao2" src="assets/modelos/bonecoNeve.glb"></a-asset-item>
    </a-assets>

    <!-- CÂMERA -->
    <a-camera position="0 0 0" look-controls="enabled: false"></a-camera>

    <!-- ======================================================= -->
    <!-- TARGET A (Index 0) -->
    <!-- ======================================================= -->
    <a-entity mindar-image-target="targetIndex: 0" id="targetA">
      <a-plane src="#background-img0" width="1.11" height="1.52" position="0 0 -0.01"
        material="shader: flat; transparent: true; opacity: 1;">
      </a-plane>

      <a-gltf-model id="modelo-0" src="#modeloPolvo" scale="1 1 1" position="0 0 0.10" rotation="90 0 0" visible="false"
        animation-mixer="clip: *; loop: repeat; timeScale: 0;">
      </a-gltf-model>

    </a-entity>

    <!-- ======================================================= -->
    <!-- TARGET B (Index 1) -->
    <!-- ======================================================= -->
    <a-entity mindar-image-target="targetIndex: 1" id="targetB">
      <a-plane src="#background-img1" width="1.11" height="1.52" position="0 0 -0.01"
        material="shader: flat; transparent: true; opacity: 1;">
      </a-plane>

      <a-gltf-model id="modelo-1" src="#modeloTubarao" scale="1 1 1" position="0 0 0.10" rotation="90 0 0"
        visible="false" animation-mixer="clip: *; loop: repeat; timeScale: 0;">
      </a-gltf-model>

    </a-entity>

    <!-- ======================================================= -->
    <!-- TARGET C (Index 2) -->
    <!-- ======================================================= -->
    <a-entity mindar-image-target="targetIndex: 2" id="targetC">
      <a-plane src="#background-img2" width="1.11" height="1.52" position="0 0 -0.01"
        material="shader: flat; transparent: true; opacity: 1;">
      </a-plane>

      <a-gltf-model id="modelo-2" src="#modeloTubarao2" scale="0.5 0.5 0.5" position="0 0 0.10" rotation="0 0 0"
        visible="false" animation-mixer="clip: *; loop: repeat; timeScale: 0;">
      </a-gltf-model>

    </a-entity>

    <!-- TARGET D (Index 3) -->
    <a-entity mindar-image-target="targetIndex: 3" id="targetD">
      <a-plane src="#background-img2" width="1.11" height="1.52" position="0 0 -0.01"
        material="shader: flat; transparent: true; opacity: 1;"></a-plane>
      <a-gltf-model id="modelo-3" src="#modeloQuarto" scale="0.5 0.5 0.5" position="0 0 0.10" visible="false"
        animation-mixer="clip: *; loop: repeat; timeScale: 0;">
      </a-gltf-model>
    </a-entity>



  </a-scene>

  <!-- ========================================================= -->
  <!-- JAVASCRIPT -->
  <!-- ========================================================= -->
  <script>
    // COMPONENTE - MUDANÇA DE COR
    AFRAME.registerComponent('color-cycle-opt', {
      schema: {
        colors: { type: 'array', default: ['#ff0000', '#0000ff', '#000000'] },
        interval: { type: 'number', default: 1000 }
      },
      init: function () {
        this.colorIndex = 0;
        this.materials = [];
        this.intervalId = null;
        this.el.addEventListener('model-loaded', this.setupMaterials.bind(this));
      },
      setupMaterials: function () {
        const model = this.el.getObject3D('mesh');
        if (!model) return;

        this.materials = [];
        model.traverse((node) => {
          if (node.isMesh && node.material) {
            const nodeMaterials = Array.isArray(node.material) ? node.material : [node.material];
            this.materials.push(...nodeMaterials);
          }
        });

        if (this.intervalId) clearInterval(this.intervalId);
        this.intervalId = setInterval(this.cycleColor.bind(this), this.data.interval);
      },
      cycleColor: function () {
        if (this.materials.length === 0) return;
        const newColor = this.data.colors[this.colorIndex];

        this.materials.forEach(material => {
          if (material.emissive) {
            if (newColor === '#000000') {
              material.emissive.set(0x000000);
              material.emissiveIntensity = 0;
            } else {
              material.emissive.set(newColor);
              material.emissiveIntensity = 0.8;
            }
          }
        });

        this.colorIndex = (this.colorIndex + 1) % this.data.colors.length;
      },
      remove: function () {
        if (this.intervalId) clearInterval(this.intervalId);
      }
    });

    // PARÂMETRO DA URL
    function getQueryParam(name) {
      const urlParams = new URLSearchParams(window.location.search);
      return urlParams.get(name);
    }

    // PERSONALIZAÇÃO DE LOGO E TÍTULO
    const clienteParam = getQueryParam('cliente');
    let logoPath = 'assets/imagens/logo-B.png';
    let titulo = '';

    switch (clienteParam ? clienteParam.toUpperCase() : '') {
      case 'A':
        logoPath = 'assets/imagens/logo-A.png';
        titulo = 'Presente de Natal - Cliente A';
        break;
      case 'B':
        logoPath = 'assets/imagens/logo-B.png';
        titulo = 'Boas Festas - Cliente B';
        break;
      case 'C':
        logoPath = 'assets/imagens/logo-B.png';
        titulo = 'Feliz Natal - Cliente C';
        break;
      case 'D':
        logoPath = 'assets/imagens/logo-B.png';
        titulo = 'Feliz Natal - Cliente D';
        break;
    }

    document.getElementById('logo-cliente').src = logoPath;
    document.getElementById('titulo-cliente').textContent = titulo;

    // SPLASH / CÂMERA
    const splash = document.getElementById('splash-screen');
    const startBtn = document.getElementById('start-button');
    const scene = document.getElementById('minha-cena');

    // ÁUDIOS
    const audios = [
      new Audio('assets/musicas/natal.mp3'),
      new Audio('assets/musicas/natal.mp3'),
      new Audio('assets/musicas/natal.mp3'),
      new Audio('assets/musicas/casamento.mp3')
    ];

    audios.forEach(audio => {
      audio.loop = true;
      audio.preload = 'auto';
    });

    startBtn.addEventListener('click', () => {
      splash.style.display = 'none';
      scene.style.display = 'block';
    });

    // DEBUG DOS MODELOS
    function debugModelo(modelo, nome) {
      if (!modelo) return;
      modelo.addEventListener('model-loaded', () => {
        console.log('MODELO CARREGADO:', nome);
      });
      modelo.addEventListener('model-error', (event) => {
        console.error('ERRO AO CARREGAR MODELO:', nome, event);
      });
    }

    debugModelo(document.querySelector('#modelo-0'), 'modelo-0');
    debugModelo(document.querySelector('#modelo-1'), 'modelo-1');
    debugModelo(document.querySelector('#modelo-2'), 'modelo-2');
    debugModelo(document.querySelector('#modelo-3'), 'modelo-3');

    // GERENCIAMENTO DE TARGETS
    function setupTarget(targetId, modeloId, audioIndex) {
      const target = document.querySelector(targetId);
      const modelo = document.querySelector(modeloId);
      const audio = audios[audioIndex];

      if (!target || !modelo) return;

      target.addEventListener('targetFound', () => {
        console.log('TARGET ENCONTRADO:', targetId);
        modelo.setAttribute('visible', 'true');
        modelo.setAttribute('animation-mixer', 'timeScale', 1);

        audios.forEach((a, i) => {
          if (i !== audioIndex) a.pause();
        });

        audio.currentTime = 0;
        audio.play().catch(error => console.log('Áudio bloqueado:', error));
      });

      target.addEventListener('targetLost', () => {
        console.log('TARGET PERDIDO:', targetId);
        modelo.setAttribute('animation-mixer', 'timeScale', 0);
        modelo.setAttribute('visible', 'false');
        audio.pause();
      });
    }

    // CONFIGURAÇÃO DOS TARGETS
    setupTarget('#targetA', '#modelo-0', 0);
    setupTarget('#targetB', '#modelo-1', 1);
    setupTarget('#targetC', '#modelo-2', 2);
    setupTarget('#targetD', '#modelo-3', 3);
  </script>

</body>

</html>