<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Cartão AR - Personalizado</title>

  <!-- A-Frame -->
  <script src="https://aframe.io/releases/1.2.0/aframe.min.js"></script>

  <!-- MindAR -->
  <script src="https://cdn.jsdelivr.net/npm/mind-ar@1.2.0/dist/mindar-image-aframe.prod.js"></script>

  <!-- Animation Mixer -->
  <script src="https://cdn.jsdelivr.net/gh/c-frame/aframe-extras@v6.1.1/dist/aframe-extras.min.js"></script>

  <style>
    body {
      margin: 0;
      overflow: hidden;
      font-family: Arial, sans-serif;
    }

    #splash-screen {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: #333;
      color: white;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      z-index: 9999;
      text-align: center;
    }

    #start-button {
      padding: 15px 30px;
      background-color: #007bff;
      color: white;
      font-size: 1.1em;
      border: none;
      border-radius: 8px;
      cursor: pointer;
      margin-top: 15px;
    }

    #start-button:active {
      transform: scale(0.97);
    }

    #logo-cliente {
      width: 120px;
      max-height: 120px;
      object-fit: contain;
      margin-bottom: 20px;
    }

    #minha-cena {
      display: none;
    }
  </style>
</head>

<body>

  <!-- ========================================================= -->
  <!-- TELA INICIAL -->
  <!-- ========================================================= -->
  <div id="splash-screen">
    <img id="logo-cliente" src="" alt="Logo Personalizado">
    <h2 id="titulo-cliente"></h2>
    <p>Toque para iniciar a câmera e ativar o som</p>
    <button id="start-button">Iniciar</button>
  </div>

  <!-- ========================================================= -->
  <!-- CENA AR -->
  <!-- ========================================================= -->
  <a-scene id="minha-cena" mindar-image="
      imageTargetSrc: markers/target.mind;
      maxTrack: 1;
      filterMinCF: 0.0001;
      filterBeta: 1000;
    " gltf-model="dracoDecoderPath: https://www.gstatic.com/draco/v1/decoders/;" color-space="sRGB"
    renderer="colorManagement: true; physicallyCorrectLights: false; exposure: 1.3;" vr-mode-ui="enabled: false"
    device-orientation-permission-ui="enabled: false">

    <a-light type="ambient" color="#FFFFFF" intensity="1.8"></a-light>

    <!-- ======================================================= -->
    <!-- ASSETS -->
    <!-- ======================================================= -->
    <a-assets timeout="10000">
      <!-- Imagens -->
      <img id="fundo" src="assets/imagens/fundo.jpg" crossorigin="anonymous">

      <!-- Modelos 3D na pasta assets/modelos -->
      <a-asset-item id="modeloPolvo" src="assets/modelos/polvo.glb"></a-asset-item>
      <a-asset-item id="modeloTubarao" src="assets/modelos/tubarao.glb"></a-asset-item>
      <a-asset-item id="modeloTartaruga" src="assets/modelos/tartaruga.glb"></a-asset-item>
      <a-asset-item id="modeloPeixe" src="assets/modelos/peixe.glb"></a-asset-item>
      <a-asset-item id="modeloOrca" src="assets/modelos/orca.glb"></a-asset-item>
      <a-asset-item id="modeloCavalo" src="assets/modelos/cavalo.glb"></a-asset-item>
    </a-assets>

    <!-- CÂMERA -->
    <a-camera position="0 0 0" look-controls="enabled: false"></a-camera>

    <!-- ======================================================= -->
    <!-- TARGET A (Index 0) -->
    <!-- ======================================================= -->
    <a-entity mindar-image-target="targetIndex: 0" id="targetA">
      <a-plane src="#fundo" width="1.11" height="1.52" position="0 0 -0.01"
        material="shader: flat; transparent: true; opacity: 1;">
      </a-plane>

      <a-gltf-model id="modelo-0" src="#modeloPolvo" scale="0.8 .8 .8" position="0 0 0.10" rotation="90 0 0"
        visible="false" animation-mixer="clip: *; loop: repeat; timeScale: 0;">
      </a-gltf-model>

    </a-entity>

    <!-- ======================================================= -->
    <!-- TARGET B (Index 1) -->
    <!-- ======================================================= -->
    <a-entity mindar-image-target="targetIndex: 1" id="targetB">
      <a-plane src="#fundo" width="1.11" height="1.52" position="0 0 -0.01"
        material="shader: flat; transparent: true; opacity: 1;">
      </a-plane>

      <a-gltf-model id="modelo-1" src="#modeloTubarao" scale="1.2 1.2 1.2" position="0 0 0.10" rotation="90 0 0"
        visible="false" animation-mixer="clip: *; loop: repeat; timeScale: 0;">
      </a-gltf-model>

    </a-entity>

    <!-- ======================================================= -->
    <!-- TARGET C (Index 2) -->
    <!-- ======================================================= -->
    <a-entity mindar-image-target="targetIndex: 2" id="targetC">
      <a-plane src="#fundo" width="1.11" height="1.52" position="0 0 -0.01"
        material="shader: flat; transparent: true; opacity: 1;">
      </a-plane>

      <a-gltf-model id="modelo-2" src="#modeloTartaruga" scale="0.4 0.4 0.4" position="0 0 0.10" rotation="90 0 0"
        visible="false" animation-mixer="clip: *; loop: repeat; timeScale: 0;">
      </a-gltf-model>

    </a-entity>

    <!-- TARGET D (Index 3) -->
    <a-entity mindar-image-target="targetIndex: 3" id="targetD">
      <a-plane src="#fundo" width="1.11" height="1.52" position="0 0 -0.01"
        material="shader: flat; transparent: true; opacity: 1;"></a-plane>
      <a-gltf-model id="modelo-3" src="#modeloPeixe" scale="0.2 0.2 0.2" position="0 0 0.10" rotation="90 0 0"
        visible="false" animation-mixer="clip: *; loop: repeat; timeScale: 0;">
      </a-gltf-model>
    </a-entity>


    <a-entity mindar-image-target="targetIndex: 4" id="targetE">
      <a-plane src="#fundo" width="1.11" height="1.52" position="0 0 -0.01"
        material="shader: flat; transparent: true; opacity: 1;"></a-plane>
      <a-gltf-model id="modelo-4" src="#modeloOrca" scale="0.4 0.4 0.4" position="0 0 0.10" rotation="90 0 0"
        visible="false" animation-mixer="clip: *; loop: repeat; timeScale: 0;">
      </a-gltf-model>
    </a-entity>

    <a-entity mindar-image-target="targetIndex: 5" id="targetF">
      <a-plane src="#fundo" width="1.11" height="1.52" position="0 0 -0.01"
        material="shader: flat; transparent: true; opacity: 1;"></a-plane>
      <a-gltf-model id="modelo-5" src="#modeloCavalo" scale="0.8 .8 .8" position="0 0 0.10" rotation="90 0 0"
        visible="false" animation-mixer="clip: *; loop: repeat; timeScale: 0;">
      </a-gltf-model>
    </a-entity>



  </a-scene>

  <!-- ========================================================= -->
  <!-- JAVASCRIPT -->
  <!-- ========================================================= -->
  <script>

    // PARÂMETRO DA URL
    function getQueryParam(name) {
      const urlParams = new URLSearchParams(window.location.search);
      return urlParams.get(name);
    }

    // PERSONALIZAÇÃO DE LOGO E TÍTULO

    logoPath = 'assets/imagens/logo-A.png';
    titulo = 'Presente de Natal - Cliente A';

    // ATRIBUIÇÃO AOS ELEMENTOS DO HTML
    const imgLogo = document.getElementById('logo-cliente');
    const elTitulo = document.getElementById('titulo-cliente');
    if (imgLogo) {
      imgLogo.src = logoPath;
    }

    if (elTitulo) {
      elTitulo.textContent = titulo;
    }

    // SPLASH / CÂMERA
    const splash = document.getElementById('splash-screen');
    const startBtn = document.getElementById('start-button');
    const scene = document.getElementById('minha-cena');

    // ÁUDIOS
    const audios = [
      new Audio('assets/musicas/oceano.mp3'),
      new Audio('assets/musicas/oceano.mp3'),
      new Audio('assets/musicas/oceano.mp3'),
      new Audio('assets/musicas/oceano.mp3'),
      new Audio('assets/musicas/oceano.mp3'),
      new Audio('assets/musicas/oceano.mp3')
    ];

    audios.forEach(audio => {
      audio.loop = true;
      audio.preload = 'auto';
    });

    startBtn.addEventListener('click', () => {
      splash.style.display = 'none';
      scene.style.display = 'block';
    });

    // DEBUG DOS MODELOS
    function debugModelo(modelo, nome) {
      if (!modelo) return;
      modelo.addEventListener('model-loaded', () => {
        console.log('MODELO CARREGADO:', nome);
      });
      modelo.addEventListener('model-error', (event) => {
        console.error('ERRO AO CARREGAR MODELO:', nome, event);
      });
    }

    debugModelo(document.querySelector('#modelo-0'), 'modelo-0');
    debugModelo(document.querySelector('#modelo-1'), 'modelo-1');
    debugModelo(document.querySelector('#modelo-2'), 'modelo-2');
    debugModelo(document.querySelector('#modelo-3'), 'modelo-3');

    // =========================================================
    // GERENCIAMENTO DE TARGETS
    // =========================================================

    const targets = [
      { targetId: '#targetA', modeloId: '#modelo-0', audioIndex: 0 },
      { targetId: '#targetB', modeloId: '#modelo-1', audioIndex: 1 },
      { targetId: '#targetC', modeloId: '#modelo-2', audioIndex: 2 },
      { targetId: '#targetD', modeloId: '#modelo-3', audioIndex: 3 },
      { targetId: '#targetE', modeloId: '#modelo-4', audioIndex: 4 },
      { targetId: '#targetF', modeloId: '#modelo-5', audioIndex: 5 },

    ];

    // Esconde TODOS os modelos antes de mostrar o novo.
    // Isso evita que o GLB da imagem anterior apareça
    // durante a troca de target.
    function esconderTodosModelos() {
      targets.forEach(item => {
        const modelo = document.querySelector(item.modeloId);

        if (modelo) {
          modelo.setAttribute('visible', 'false');
          modelo.setAttribute('animation-mixer', 'timeScale', 0);
        }
      });
    }

    // Para todos os áudios antes de iniciar o áudio
    // correspondente ao novo target.
    function pararTodosAudios() {
      audios.forEach(audio => {
        audio.pause();
        audio.currentTime = 0;
      });
    }

    targets.forEach(item => {

      const target = document.querySelector(item.targetId);
      const modelo = document.querySelector(item.modeloId);
      const audio = audios[item.audioIndex];

      if (!target || !modelo) return;

      // =======================================================
      // NOVA IMAGEM ENCONTRADA
      // =======================================================
      target.addEventListener('targetFound', () => {

        console.log('TARGET ENCONTRADO:', item.targetId);

        // PRIMEIRO: esconde imediatamente todos os GLBs.
        esconderTodosModelos();

        // Para todos os áudios.
        pararTodosAudios();

        // Espera o próximo frame antes de mostrar
        // o modelo correto.
        requestAnimationFrame(() => {

          // Mostra SOMENTE o GLB deste target.
          modelo.setAttribute('visible', 'true');

          // Ativa a animação.
          modelo.setAttribute('animation-mixer', 'timeScale', 1);

          // Inicia o áudio correspondente.
          audio.currentTime = 0;

          audio.play().catch(error => {
            console.log('Áudio bloqueado:', error);
          });

        });
      });

      // =======================================================
      // IMAGEM PERDIDA
      // =======================================================
      target.addEventListener('targetLost', () => {

        console.log('TARGET PERDIDO:', item.targetId);

        // Esconde imediatamente o GLB deste target.
        modelo.setAttribute('visible', 'false');

        // Para a animação.
        modelo.setAttribute('animation-mixer', 'timeScale', 0);

        // Para o áudio.
        audio.pause();
        audio.currentTime = 0;
      });
    });

  </script>

</body>

</html>